<Project Sdk="Eto.Forms/2.11.0">

  <!--
    The Eto SDK picks the backend from the host OS or the runtime identifier (Wpf on Windows,
    Mac64 on macOS, Gtk on Linux), adds the matching platform package, appends the -windows
    target framework suffix that the Windows backends require, and keeps a separate obj and bin
    per platform. Set BuildPlatform to override it.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <UseWinForms>True</UseWinForms>
    <RootNamespace>RhTransfer.Gui</RootNamespace>
    <AssemblyName>RhinoSettingsTransfer</AssemblyName>
    <MacBundleName>Rhino Settings Transfer</MacBundleName>
  </PropertyGroup>

  <!--
    Trim the framework out of the published bundle: 83 MB down to 31 MB. TrimMode partial only
    touches assemblies that opt in, which is the .NET libraries and not Eto or MonoMac, so Eto's
    reflection over its own handler types is left alone.

    Eto and MonoMac still raise trim analyser warnings about their own code, which our warnings
    as errors setting would otherwise turn into a failed publish. Ahead of time compilation is
    not an option here: it fails in Eto's bundling step, and MonoMac registers Objective-C types
    at runtime.
  -->
  <!--
    Trimmed on macOS only: 83 MB down to 31 MB. TrimMode partial touches only assemblies that
    opt in, which is the .NET libraries and not Eto or MonoMac, so Eto keeps its own handler
    reflection.

    Not on Windows. Windows Forms is not trim compatible: the trimmer strips the COM interop
    types RichTextBox needs, and Eto's TextArea is a RichTextBox, so the window died with an
    InvalidCastException in RichTextBox.UpdateOleCallback the moment it drew.

    The self contained check matters too, because Eto's macOS bundling runs an inner build that
    is not self contained and trimming there fails with NETSDK1102.
  -->
  <PropertyGroup>
    <PublishTrimmed Condition="'$(SelfContained)' == 'true' and $(RuntimeIdentifier.StartsWith('osx'))">true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <NoWarn>$(NoWarn);IL2104;IL2026;IL2072;IL2075</NoWarn>
  </PropertyGroup>

  <!-- BuildPlatform is not set until the SDK's targets run, so key the bundle files off the OS. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="Info.plist" />
    <Content Include="Icon.icns">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RhTransfer.Core\RhTransfer.Core.csproj" />
  </ItemGroup>

</Project>
