<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		The hardened runtime is required for notarisation, and it blocks three things the .NET
		runtime needs. The window is a normal self contained app running on CoreCLR, so it JITs;
		the command line binary is compiled ahead of time and needs none of this, but signing both
		with the same entitlements keeps the script simple.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
