<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.0</Version>
    <Authors>Robert McNeel &amp; Associates</Authors>
    <Product>Rhino Settings Transfer</Product>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Embedded rather than a loose .pdb, so a release folder is just the things you run. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      CS8524 fires when a switch over an enum handles every named member but not an out of range
      cast. Silencing it keeps CS8509 (a genuinely missing member) as an error, so adding an enum
      member still breaks the build. A discard arm would silence both.
    -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

</Project>
